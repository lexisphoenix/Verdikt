{
  "name": "verdikt",
  "private": true,
  "dependencies": {
    "next": "16.2.11"
  },
  "scripts": {
    "dev": "pnpm --filter @verdikt/web dev",
    "build": "pnpm --filter @verdikt/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @verdikt/web prisma generate",
    "db:migrate": "pnpm --filter @verdikt/web prisma migrate dev",
    "db:seed": "pnpm --filter @verdikt/web db:seed",
    "db:reset": "pnpm --filter @verdikt/web db:reset"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "1.62.0"
  }
}
